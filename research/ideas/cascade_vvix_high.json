{
 "id": "cascade_vvix_high",
 "name": "Cascade only when VVIX ≥ 100",
 "why": "High vol-of-vol: option dealers short gamma hedge with the move, so the open's direction carries. Pre-registered 2026-10-16 (research/preregistered/2026-10-16_free_macro_filters.md).",
 "params": {
  "k1": [
   0.2,
   0.25,
   0.3
  ],
  "k2": [
   0.25,
   0.3,
   0.35
  ],
  "stopk": [
   0.2,
   0.25,
   0.35
  ],
  "rr": [
   2,
   3
  ]
 },
 "checks": [
  {
   "at": "09:50",
   "when": "vvix >= 100 && (abs(px-open) > k1*atr)",
   "dir": "sign(px-open)"
  },
  {
   "at": "10:30",
   "when": "vvix >= 100 && (abs(px-open) > k2*atr)",
   "dir": "sign(px-open)"
  },
  {
   "at": "11:00",
   "when": "vvix >= 100 && (abs(px-open) > k2*atr)",
   "dir": "sign(px-open)"
  },
  {
   "at": "11:30",
   "when": "vvix >= 100 && (abs(px-open) > k2*atr)",
   "dir": "sign(px-open)"
  }
 ],
 "stop": "stopk*atr",
 "target": "rr",
 "flat": "15:55",
 "control_pct": 0.99,
 "control_seeds": 400
}