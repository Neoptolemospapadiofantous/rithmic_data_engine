{
 "id": "cascade_rvol",
 "name": "Cascade only on heavy opening volume (≥ 1.2× the 20-day same-minute average)",
 "why": "Heavy participation at the open means the big orders are actually there. Pre-registered 2026-10-16 (research/preregistered/2026-10-16_new_angles.md).",
 "params": {
  "k1": [
   0.2,
   0.25,
   0.3
  ],
  "k2": [
   0.25,
   0.3,
   0.35
  ],
  "stopk": [
   0.2,
   0.25,
   0.35
  ],
  "rr": [
   2,
   3
  ]
 },
 "checks": [
  {
   "at": "09:50",
   "when": "rvol >= 1.2 && (abs(px-open) > k1*atr)",
   "dir": "sign(px-open)"
  },
  {
   "at": "10:30",
   "when": "rvol >= 1.2 && (abs(px-open) > k2*atr)",
   "dir": "sign(px-open)"
  },
  {
   "at": "11:00",
   "when": "rvol >= 1.2 && (abs(px-open) > k2*atr)",
   "dir": "sign(px-open)"
  },
  {
   "at": "11:30",
   "when": "rvol >= 1.2 && (abs(px-open) > k2*atr)",
   "dir": "sign(px-open)"
  }
 ],
 "stop": "stopk*atr",
 "target": "rr",
 "flat": "15:55",
 "control_pct": 0.992,
 "control_seeds": 400
}