{
  "id": "casc_flow_twin",
  "name": "Strong-open cascade: 09:50, then 10:30/11:00/11:30 (one trade a day) — order-flow days only (twin)",
  "why": "Same institutional open flow as strong_open; on days the open is quiet the flow often starts later in the morning (European close, delayed program orders), so re-checking at 10:30-11:30 catches it. D twin, pre-registered 2026-10-17.",
  "params": {
    "k1": [
      0.2,
      0.25,
      0.3
    ],
    "k2": [
      0.25,
      0.3,
      0.35
    ],
    "stopk": [
      0.2,
      0.25,
      0.35
    ],
    "rr": [
      2,
      3
    ]
  },
  "checks": [
    {
      "at": "09:50",
      "when": "flow && (abs(px-open) > k1*atr)",
      "dir": "sign(px-open)"
    },
    {
      "at": "10:30",
      "when": "flow && (abs(px-open) > k2*atr)",
      "dir": "sign(px-open)"
    },
    {
      "at": "11:00",
      "when": "flow && (abs(px-open) > k2*atr)",
      "dir": "sign(px-open)"
    },
    {
      "at": "11:30",
      "when": "flow && (abs(px-open) > k2*atr)",
      "dir": "sign(px-open)"
    }
  ],
  "stop": "stopk*atr",
  "target": "rr",
  "flat": "15:55",
  "from": "2023-03-01",
  "min_trades": 60,
  "train_months": 6
}
