{
 "id": "cascade_ema_filter",
 "name": "Strong-open cascade, only when the 60-minute EMA trend agrees",
 "why": "The open's institutional flow should carry further when the trend-followers' 60-minute trend points the same way. Pre-registered 2026-10-16 (research/preregistered/2026-10-16_vwap_ema.md).",
 "params": {
  "k1": [
   0.2,
   0.25,
   0.3
  ],
  "k2": [
   0.25,
   0.3,
   0.35
  ],
  "stopk": [
   0.2,
   0.25,
   0.35
  ],
  "rr": [
   2,
   3
  ]
 },
 "checks": [
  {
   "at": "09:50",
   "when": "sign(cl(60,1) - ema(60,20)) == sign(px - open) && (abs(px-open) > k1*atr)",
   "dir": "sign(px-open)"
  },
  {
   "at": "10:30",
   "when": "sign(cl(60,1) - ema(60,20)) == sign(px - open) && (abs(px-open) > k2*atr)",
   "dir": "sign(px-open)"
  },
  {
   "at": "11:00",
   "when": "sign(cl(60,1) - ema(60,20)) == sign(px - open) && (abs(px-open) > k2*atr)",
   "dir": "sign(px-open)"
  },
  {
   "at": "11:30",
   "when": "sign(cl(60,1) - ema(60,20)) == sign(px - open) && (abs(px-open) > k2*atr)",
   "dir": "sign(px-open)"
  }
 ],
 "stop": "stopk*atr",
 "target": "rr",
 "flat": "15:55",
 "control_pct": 0.99,
 "control_seeds": 400
}