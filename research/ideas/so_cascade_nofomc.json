{"id":"so_cascade_nofomc","name":"Strong-open cascade, FOMC decision days skipped",
 "why":"On FOMC days the 14:00 decision dominates and morning flow is position-squaring that reverses; skipping them removes a known loser (PF 0.54 in earlier research).",
 "params":{"k1":[0.2,0.25,0.3],"k2":[0.25,0.3,0.35],"stopk":[0.2,0.25,0.35],"rr":[2,3]},
 "checks":[{"at":"09:50","when":"!fomc && abs(px-open) > k1*atr","dir":"sign(px-open)"},
           {"at":"10:30","when":"!fomc && abs(px-open) > k2*atr","dir":"sign(px-open)"},
           {"at":"11:00","when":"!fomc && abs(px-open) > k2*atr","dir":"sign(px-open)"},
           {"at":"11:30","when":"!fomc && abs(px-open) > k2*atr","dir":"sign(px-open)"}],
 "stop":"stopk*atr","target":"rr","flat":"15:55"}
