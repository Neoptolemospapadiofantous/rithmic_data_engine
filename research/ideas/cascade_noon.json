{
  "id": "cascade_noon",
  "name": "Strong-open cascade + a 12:00 any-move check",
  "why": "Same institutional open flow as strong_open; on days the open is quiet the flow often starts later in the morning (European close, delayed program orders), so re-checking at 10:30-11:30 catches it. + 12:00 any-move check, pre-registered 2026-10-17 (research/preregistered/2026-10-17_daily_trade.md).",
  "params": {
    "k1": [
      0.2,
      0.25,
      0.3
    ],
    "k2": [
      0.25,
      0.3,
      0.35
    ],
    "stopk": [
      0.2,
      0.25,
      0.35
    ],
    "rr": [
      2,
      3
    ]
  },
  "checks": [
    {
      "at": "09:50",
      "when": "abs(px-open) > k1*atr",
      "dir": "sign(px-open)"
    },
    {
      "at": "10:30",
      "when": "abs(px-open) > k2*atr",
      "dir": "sign(px-open)"
    },
    {
      "at": "11:00",
      "when": "abs(px-open) > k2*atr",
      "dir": "sign(px-open)"
    },
    {
      "at": "11:30",
      "when": "abs(px-open) > k2*atr",
      "dir": "sign(px-open)"
    },
    {
      "at": "12:00",
      "when": "px != open",
      "dir": "sign(px - open)"
    }
  ],
  "stop": "stopk*atr",
  "target": "rr",
  "flat": "15:55"
}
