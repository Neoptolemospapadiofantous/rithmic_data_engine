# paper-engine-local-crypto-eth.service — FORWARD crypto paper fleet (ETH, label crypto) on the crypto collector's
# Binance ticks/bbo (systemd USER unit). Paper only: no exchange account, no orders. Built by scripts/crypto_fleet.sh.
# Install: cp deploy/paper-engine-local-crypto-eth.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#          systemctl --user enable --now paper-engine-local-crypto-eth
[Unit]
Description=Crypto paper fleet ETH (config/paper_fleet_crypto_eth.json, label crypto) on Binance ticks
After=network-online.target postgresql.service crypto-collector-local.service
Wants=crypto-collector-local.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/theone/Desktop/rithmic_engine
EnvironmentFile=/home/theone/Desktop/rithmic_engine/.env
ExecStart=/home/theone/Desktop/rithmic_engine/build/paper_engine --config config/paper_fleet_crypto_eth.json
StandardOutput=append:/home/theone/Desktop/rithmic_engine/data/logs/paper_engine_crypto_eth.log
StandardError=append:/home/theone/Desktop/rithmic_engine/data/logs/paper_engine_crypto_eth.log
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20
# Research fleet: below the NQ paper engines and never competing with the live executor.
Nice=5
CPUWeight=50
MemoryMax=2G
OOMScoreAdjust=300

[Install]
WantedBy=default.target
