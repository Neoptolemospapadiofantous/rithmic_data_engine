# mm-paper-hl-local.service — the SHADOW paper market maker that quotes around a HYPERLIQUID-ANCHORED fair price
# (label paper_hl; founder 2026-10-26, docs/market_making_plan.md §8: "apply both now and build the HL shadow").
# Same markets, same frozen setting as mm-paper-local ($11 quotes on Lighter's size grid, 300 ms, inventory carried
# across 00:00 UTC), plus --hl-anchor 1: mm_paper also reads Hyperliquid's public l2Book and centres its quotes on
# our mid + 1 × (HL-implied price − our mid), the basis taken as a trailing 5-minute median (mmpaper::HlAnchor, the
# rule of mm_lab's hl_anchor). A coin Hyperliquid does not list, a stale HL book (> 5 s) or < 60 basis samples =
# quotes on its own mid. No keys, no order path. Writes under label 'paper_hl' in the shared mm_paper_* tables, its
# own status file and drop ledgers; same kill file. The gates read only label 'paper': this is a shadow, nothing here
# has passed mm_lab or a holdout.
#
# NOT installed. Install: cp deploy/mm-paper-hl-local.service ~/.config/systemd/user/ && systemctl --user daemon-reload \
#                         && systemctl --user enable --now mm-paper-hl-local
# Check:   systemctl --user status mm-paper-hl-local ; tail -f data/logs/mm_paper_hl.log ; cat data/mm_paper/status_paper_hl.json
[Unit]
Description=Lighter paper market maker, shadow on a Hyperliquid-anchored fair (no orders), 24/7
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/theone/Desktop/rithmic_engine
ExecStart=/home/theone/Desktop/rithmic_engine/build/mm_paper --label paper_hl --hl-anchor 1 --latency-ms 300 --tick-rule hl --status data/mm_paper/status_paper_hl.json --symbols AAVE,BNB,ONDO,AVAX,DOT,XLM,ASTER,TRUMP,FIL,OP,CC,POL,WIF,EIGEN,BERA,AZTEC,APEX,UNI,CRV,PYTH,ETHFI,SEI,2Z,GMX
StandardOutput=append:/home/theone/Desktop/rithmic_engine/data/logs/mm_paper_hl.log
StandardError=append:/home/theone/Desktop/rithmic_engine/data/logs/mm_paper_hl.log
Restart=always
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=20
Nice=10
OOMScoreAdjust=100
MemoryMax=512M

[Install]
WantedBy=default.target
