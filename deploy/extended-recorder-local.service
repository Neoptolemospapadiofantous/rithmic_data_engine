# extended-recorder-local.service — 24/7 Extended (Starknet perps, 0 maker fee + maker rebate) order-book + trade
# archive, the second venue after Lighter in the market-making plan (founder 2026-10-25: "lets set everything").
# systemd USER unit, modeled on lighter-recorder-local.service. Public data, no keys, no orders.
#
# Install once:
#   mkdir -p /media/theone/381C48C51C48803C/rithmic_dex/extended
#   cp deploy/extended-recorder-local.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now extended-recorder-local
# Check:   tail -f data/logs/dex_recorder_extended.log ; scripts/lag_check.sh /media/theone/381C48C51C48803C/rithmic_dex/extended
# Replay:  build/mm_sim --dir /media/theone/381C48C51C48803C/rithmic_dex/extended  (scripts/mm_venues.sh does it daily)
#
# One websocket per market per stream (Extended has no combined stream): 32 markets = 64 connections, hence the
# larger memory cap. The coins are the Lighter list plus the majors that trade on Extended; the binary skips any
# the venue does not list and refuses to start when the archive directory is missing (unmounted second drive).
[Unit]
Description=Extended book/trade recorder (market-making research archive), 24/7
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/theone/Desktop/rithmic_engine
ExecStart=/home/theone/Desktop/rithmic_engine/build/dex_recorder --venue extended --out /media/theone/381C48C51C48803C/rithmic_dex/extended --symbols AAVE,BNB,ONDO,AVAX,DOT,XLM,ASTER,FIL,EIGEN,AZTEC,UNI,CRV,ETHFI,SEI,HYPE,NEAR,ENA,WLD,ARB,SUI,ZRO,JUP,TAO,LTC,XMR,PUMP,FARTCOIN,LINK,DOGE,ADA,XRP,SOL
StandardOutput=append:/home/theone/Desktop/rithmic_engine/data/logs/dex_recorder_extended.log
StandardError=append:/home/theone/Desktop/rithmic_engine/data/logs/dex_recorder_extended.log
Restart=always
RestartSec=60
KillSignal=SIGTERM
TimeoutStopSec=20
Nice=15
CPUWeight=50
IOWeight=50
OOMScoreAdjust=100
MemoryMax=512M

[Install]
WantedBy=default.target
