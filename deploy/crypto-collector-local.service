# crypto-collector-local.service — 24/7 crypto market data on the LOCAL box
# (systemd USER unit, modeled on rithmic-collector-local.service).
#
# Install once:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/crypto-collector-local.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now crypto-collector-local
# Check:   systemctl --user status crypto-collector-local ; tail -f data/logs/crypto_collector.log
# Stop:    systemctl --user stop crypto-collector-local
#
# build/crypto_collector writes Binance USDⓈ-M futures BTCUSDT/ETHUSDT trades → ticks and
# throttled top of book → bbo (exchange 'BINANCE', source 'binance_fut'), and archives the
# Bitstamp BTC/ETH market-by-order stream to data/mbo/bitstamp/<pair>/<date>.jsonl.zst
# (kept forever) plus a per-minute mbo_1m summary. One Postgres connection, async commit,
# bounded queue that drops its own rows rather than slow the NQ collector's writer.
[Unit]
Description=Crypto collector (Binance futures ticks/bbo + Bitstamp MBO → local Postgres), 24/7
After=network-online.target postgresql.service rithmic-collector-local.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/theone/Desktop/rithmic_engine
ExecStart=/home/theone/Desktop/rithmic_engine/build/crypto_collector
StandardOutput=append:/home/theone/Desktop/rithmic_engine/data/logs/crypto_collector.log
StandardError=append:/home/theone/Desktop/rithmic_engine/data/logs/crypto_collector.log
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20
# Below the NQ collector on every axis: it is the live executor's feed, this is research data.
Nice=10
CPUWeight=100
IOWeight=100
OOMScoreAdjust=500
MemoryMax=512M

[Install]
WantedBy=default.target
