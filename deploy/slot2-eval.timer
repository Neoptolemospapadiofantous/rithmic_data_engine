# slot2-eval.timer — weekdays 16:20 New York, after the 16:05 close and the 16:10 execution
# audit. Persistent=true: a missed run fires at next boot; the script refuses inside regular
# hours and catches up every unreplayed session on its next run.
[Unit]
Description=Weekdays 16:20 New York: slot-2 paper test replay + report

[Timer]
OnCalendar=Mon..Fri 16:20 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
