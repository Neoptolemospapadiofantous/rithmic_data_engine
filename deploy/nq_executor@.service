[Unit]
Description=NQ ORB Executor %I
After=network-online.target postgresql-16.service
Wants=network-online.target
Requires=postgresql-16.service
StartLimitIntervalSec=300s
StartLimitBurst=3
Conflicts=nq_executor-24x7@%i.service

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/home/opc/rithmic_engine
EnvironmentFile=/home/opc/rithmic_engine/.env
EnvironmentFile=-/home/opc/rithmic_engine/.env.%I
UnsetEnvironment=NQ_FIRE_TEST_ORDER
ExecStartPre=/bin/bash -c '[ ! -f /home/opc/rithmic_engine/NO_DEPLOY ] || { echo "NO_DEPLOY lockfile present"; exit 1; }'
ExecStart=/home/opc/rithmic_engine/build/nq_executor --config /home/opc/rithmic_engine/config/%I_config.json
TimeoutStartSec=90s
Restart=on-failure
RestartSec=30s
TimeoutStopSec=30s
KillMode=process
KillSignal=SIGTERM
SendSIGKILL=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nq_executor_%I

[Install]
WantedBy=multi-user.target
