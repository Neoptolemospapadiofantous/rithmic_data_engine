# manual-review.timer — weekdays 16:15 New York (after the 16:10 execution audit). If the fills file lands later, run
# scripts/manual_review.sh [date] by hand; re-running a day replaces its rows in the ledger.
[Unit]
Description=Weekdays 16:15 New York: hand trades vs the plan

[Timer]
OnCalendar=Mon..Fri 16:15 America/New_York
Persistent=false

[Install]
WantedBy=timers.target
