# mm-paper-w7-local.service — experiment E2 (research/preregistered/2026-10-28_mm_next.md): paper_opt with quotes 7 ticks
# from the fair price instead of 5 (live). Same delays, rate limit, cap and markets as paper_opt; one change only.
# Rule (fixed before the data): after >= 7 UTC days and >= 300 fills, adopt if net $ >= paper_opt and ahead on >= 4 days.
# Install: cp deploy/mm-paper-w7-local.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now mm-paper-w7-local
[Unit]
Description=Lighter paper market maker, E2 wider quotes (paper_opt + half width 7 ticks), 24/7
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/theone/Desktop/rithmic_engine
ExecStart=/home/theone/Desktop/rithmic_engine/build/mm_paper --label paper_w7 --latency-ms 300 --place-latency-ms 314 --cancel-latency-ms 614 --rate-limit 60 --pause-move-ticks 1 --pause-ms 4000 --min-spread-ticks 5 --half-width-ticks 7 --max-inv 1 --tick-rule hl --status data/mm_paper/status_paper_w7.json --symbols AAVE,BNB,ONDO,AVAX,DOT,XLM,ASTER,TRUMP,FIL,OP,CC,POL,WIF,EIGEN,BERA,AZTEC,APEX,UNI,CRV,PYTH,ETHFI,SEI,2Z,GMX
StandardOutput=append:/home/theone/Desktop/rithmic_engine/data/logs/mm_paper_w7.log
StandardError=append:/home/theone/Desktop/rithmic_engine/data/logs/mm_paper_w7.log
Restart=always
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=20
Nice=10
OOMScoreAdjust=100
MemoryMax=512M

[Install]
WantedBy=default.target
