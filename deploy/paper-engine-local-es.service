# paper-engine-local.service — 24/7 paper fleet on the LOCAL box (systemd USER unit).
# Install: cp deploy/paper-engine-local.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#          systemctl --user enable --now paper-engine-local
# The dashboard's Paper ▶/■ buttons drive this unit when it is installed.
[Unit]
Description=ES mirror paper fleet (config/paper_fleet_es.json, label es) on the collector's Postgres ticks
After=network-online.target postgresql.service rithmic-collector-local.service
Wants=rithmic-collector-local.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/theone/Desktop/rithmic_engine
EnvironmentFile=/home/theone/Desktop/rithmic_engine/.env
ExecStart=/home/theone/Desktop/rithmic_engine/build/paper_engine --config config/paper_fleet_es.json
StandardOutput=append:/home/theone/Desktop/rithmic_engine/data/logs/paper_engine_es.log
StandardError=append:/home/theone/Desktop/rithmic_engine/data/logs/paper_engine_es.log
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20
# Keep the fleet resident but bounded — it must never compete with the live executor.
MemoryMin=64M
MemoryMax=2G
# Same OOM priority as the collector/executor units (stack_status flags >100 as unprotected).
OOMScoreAdjust=100

[Install]
WantedBy=default.target
