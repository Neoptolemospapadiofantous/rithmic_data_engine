# mm-paper-ext-local.service — the 24/7 PAPER market maker on Extended (2026-10-29): Extended is the only venue whose
# nightly replay is net positive (+2.28 bps over 3 complete days, data/mm_gates/report.md "Other venues",
# scripts/mm_venues.sh), so this is its forward test on live data. Same engine and frozen setting as mm-paper-local,
# fed by Extended's public book + publicTrades websockets (mm_paper --venue extended; one connection per stream per
# market, the streams dex_recorder archives) and converted exactly as the replay converts the archive. Maker 0 bps,
# taker 2.5 bps (flattens only); 100 ms delay = the venue replay's figure (Extended imposes no Standard-account delay
# like Lighter's 200 ms); Extended's own price grid and size grid/minimums (some minimums exceed $11 — the quote is
# rounded UP to them). Label paper_ext. PAPER ONLY: no keys, no order path. Symbols = the coins dex_recorder records
# on Extended (deploy/extended-recorder-local.service); markets with an empty book on Extended simply never quote.
# --hl-anchor / --bn-pull are Lighter-only and refused with --venue extended.
# Install: cp deploy/mm-paper-ext-local.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now mm-paper-ext-local
[Unit]
Description=Extended MM paper engine (label paper_ext, frozen setting, 100 ms)
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/theone/Desktop/rithmic_engine
ExecStart=/home/theone/Desktop/rithmic_engine/build/mm_paper --venue extended --label paper_ext --latency-ms 100 --tick-rule hl --status data/mm_paper/status_paper_ext.json --symbols AAVE,BNB,ONDO,AVAX,DOT,XLM,ASTER,FIL,EIGEN,AZTEC,UNI,CRV,ETHFI,SEI,HYPE,NEAR,ENA,WLD,ARB,SUI,ZRO,JUP,TAO,LTC,XMR,PUMP,FARTCOIN,LINK,DOGE,ADA,XRP,SOL
StandardOutput=append:/home/theone/Desktop/rithmic_engine/data/logs/mm_paper_ext.log
StandardError=append:/home/theone/Desktop/rithmic_engine/data/logs/mm_paper_ext.log
Restart=always
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=20
Nice=10
OOMScoreAdjust=100
MemoryMax=512M

[Install]
WantedBy=default.target
